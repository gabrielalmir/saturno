---
import { Icon } from '@astrojs/starlight/components';
import project from 'virtual:starlight/project-context';

const pagefindTranslations = {
	placeholder: Astro.locals.t('search.label'),
	...Object.fromEntries(
		Object.entries(Astro.locals.t.all())
			.filter(([key]) => key.startsWith('pagefind.'))
			.map(([key, value]) => [key.replace('pagefind.', ''), value])
	),
};

const dataAttributes: DOMStringMap = { 'data-translations': JSON.stringify(pagefindTranslations) };
if (project.trailingSlash === 'never') dataAttributes['data-strip-trailing-slash'] = '';
---

<site-search class={Astro.props.class} {...dataAttributes}>
	<button
		data-open-modal
		disabled
		aria-label={Astro.locals.t('search.label')}
		aria-keyshortcuts="Control+K"
	>
		<Icon name="magnifier" />
		<span class="search-label" aria-hidden="true">Buscar na documentação</span>
		<kbd class="sl-hidden md:sl-flex" style="display: none;">
			<kbd>{Astro.locals.t('search.ctrlKey')}</kbd><kbd>K</kbd>
		</kbd>
	</button>

	<dialog style="padding:0" aria-label={Astro.locals.t('search.label')}>
		<div class="dialog-frame sl-flex">
			<div class="search-modal-head">
				<p class="search-modal-title">Search Saturno Docs</p>
				<p class="search-modal-subtitle">Tente: quick start, docker, sprint planning, webhooks</p>
			</div>
			<button data-close-modal class="close-modal-btn sl-flex" type="button" aria-label="Fechar busca">
				<Icon name="close" />
			</button>
			{
				import.meta.env.DEV ? (
					<div style="margin: auto; text-align: center; white-space: pre-line;" dir="ltr">
						<p>{Astro.locals.t('search.devWarning')}</p>
					</div>
				) : (
					<div class="search-container">
						<div id="starlight__search" />
					</div>
				)
			}
		</div>
	</dialog>
</site-search>

<script is:inline>
	(() => {
		const openBtn = document.querySelector('button[data-open-modal]');
		const shortcut = openBtn?.querySelector('kbd');
		if (!openBtn || !(shortcut instanceof HTMLElement)) return;
		const platformKey = shortcut.querySelector('kbd');
		if (platformKey && /(Mac|iPhone|iPod|iPad)/i.test(navigator.platform)) {
			platformKey.textContent = '⌘';
			openBtn.setAttribute('aria-keyshortcuts', 'Meta+K');
		}
		shortcut.style.display = '';
	})();
</script>

<script>
	import { pagefindUserConfig } from 'virtual:starlight/pagefind-config';

	class SiteSearch extends HTMLElement {
		constructor() {
			super();
			const openBtn = this.querySelector<HTMLButtonElement>('button[data-open-modal]')!;
			const closeBtn = this.querySelector<HTMLButtonElement>('button[data-close-modal]')!;
			const dialog = this.querySelector('dialog')!;
			const dialogFrame = this.querySelector('.dialog-frame')!;
			const recentQueryKey = 'saturno-docs-last-query';

			const findInput = () => this.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
			const isTypingContext = (el: Element | null) =>
				!!el &&
				(el.closest('input, textarea, select, [contenteditable="true"], [contenteditable=""]') !== null);

			const saveQuery = () => {
				const input = findInput();
				if (!input) return;
				const value = input.value.trim();
				if (value) localStorage.setItem(recentQueryKey, value);
			};

			const restoreQuery = () => {
				const value = localStorage.getItem(recentQueryKey);
				if (!value) return;
				const input = findInput();
				if (!input || input.value.trim()) return;
				input.value = value;
				input.dispatchEvent(new Event('input', { bubbles: true }));
			};

			const focusInput = () => {
				const input = findInput();
				if (input) {
					input.focus();
					input.select();
					return;
				}
				setTimeout(() => {
					const lateInput = findInput();
					if (lateInput) lateInput.focus();
				}, 120);
			};

			const closeModal = () => {
				saveQuery();
				dialog.close();
			};

			const onClick = (event: MouseEvent) => {
				const target = event.target as Node | null;
				const isLink = target instanceof Element && !!target.closest('a[href]');
				if (
					isLink ||
					(document.body.contains(target) && !dialogFrame.contains(target as Node))
				) {
					closeModal();
				}
			};

			const openModal = (event?: Event) => {
				dialog.showModal();
				document.body.toggleAttribute('data-search-modal-open', true);
				focusInput();
				restoreQuery();
				event?.stopPropagation();
				window.addEventListener('click', onClick);
			};

			openBtn.addEventListener('click', openModal);
			openBtn.disabled = false;
			closeBtn.addEventListener('click', closeModal);

			dialog.addEventListener('close', () => {
				document.body.toggleAttribute('data-search-modal-open', false);
				window.removeEventListener('click', onClick);
			});

			window.addEventListener('keydown', (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
					dialog.open ? closeModal() : openModal(e);
					e.preventDefault();
					return;
				}

				if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
					const active = document.activeElement as Element | null;
					if (!isTypingContext(active) && !dialog.open) {
						e.preventDefault();
						openModal(e);
					}
				}

				if (e.key === 'Escape' && dialog.open) {
					closeModal();
				}
			});

			let translations = {};
			try {
				translations = JSON.parse(this.dataset.translations || '{}');
			} catch {}

			const shouldStrip = this.dataset.stripTrailingSlash !== undefined;
			const stripTrailingSlash = (path: string) => path.replace(/(.)\/(#.*)?$/, '$1$2');
			const formatURL = shouldStrip ? stripTrailingSlash : (path: string) => path;

			window.addEventListener('DOMContentLoaded', () => {
				if (import.meta.env.DEV) return;
				const onIdle = window.requestIdleCallback || ((cb) => setTimeout(cb, 1));
				onIdle(async () => {
					// @ts-expect-error — Missing types for @pagefind/default-ui package.
					const { PagefindUI } = await import('@pagefind/default-ui');
					new PagefindUI({
						...pagefindUserConfig,
						element: '#starlight__search',
						baseUrl: import.meta.env.BASE_URL,
						bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
						showImages: false,
						showSubResults: true,
						translations,
						processResult: (result: { url: string; sub_results: Array<{ url: string }> }) => {
							result.url = formatURL(result.url);
							result.sub_results = result.sub_results.map((sub_result) => {
								sub_result.url = formatURL(sub_result.url);
								return sub_result;
							});
						},
					});
					restoreQuery();
				});
			});
		}
	}

	customElements.define('site-search', SiteSearch);
</script>

<style>
	@layer starlight.core {
		site-search {
			display: contents;
		}

		button[data-open-modal] {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			border: 1px solid var(--docs-panel-border, var(--sl-color-gray-5));
			background: var(--docs-panel-bg, var(--sl-color-black));
			color: var(--sl-color-gray-2);
			cursor: pointer;
			height: 2.5rem;
			font-size: var(--sl-text-sm);
			border-radius: 0.6rem;
			padding-inline: 0.75rem 0.5rem;
			width: 100%;
			max-width: 24rem;
		}

		button[data-open-modal]:hover {
			border-color: var(--sl-color-accent);
			color: var(--sl-color-gray-1);
		}

		.search-label {
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		button[data-open-modal] > :last-child {
			margin-inline-start: auto;
		}

		button > kbd {
			border-radius: 0.25rem;
			font-size: var(--sl-text-2xs);
			gap: 0.25em;
			padding-inline: 0.375rem;
			background-color: var(--sl-color-gray-6);
		}

		kbd {
			font-family: var(--__sl-font);
		}

		dialog {
			margin: 0;
			background: var(--docs-panel-bg, var(--sl-color-gray-6));
			border: 1px solid var(--docs-panel-border, var(--sl-color-gray-5));
			width: 100%;
			max-width: 100%;
			height: 100%;
			max-height: 100%;
			box-shadow: var(--sl-shadow-lg);
		}

		dialog[open] {
			display: flex;
		}

		dialog::backdrop {
			background-color: var(--sl-color-backdrop-overlay);
			-webkit-backdrop-filter: blur(0.25rem);
			backdrop-filter: blur(0.25rem);
		}

		.dialog-frame {
			position: relative;
			overflow: auto;
			flex-direction: column;
			flex-grow: 1;
			gap: 1.25rem;
			padding: 1.25rem 1.25rem 1.5rem;
			min-width: 0;
		}

		.search-modal-head {
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			padding-inline-end: 3rem;
			min-width: 0;
		}

		.search-modal-title {
			margin: 0;
			font-size: var(--sl-text-base);
			font-weight: 600;
			color: var(--sl-color-gray-1);
		}

		.search-modal-subtitle {
			margin: 0;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-4);
			line-height: 1.4;
			word-break: break-word;
		}

		.close-modal-btn {
			position: absolute;
			top: 0.9rem;
			right: 0.9rem;
			align-items: center;
			justify-content: center;
			height: 2rem;
			width: 2rem;
			border-radius: 0.5rem;
			border: 1px solid var(--docs-panel-border, var(--sl-color-gray-5));
			background: var(--docs-panel-bg, var(--sl-color-black));
			color: var(--sl-color-gray-2);
			cursor: pointer;
		}

		.close-modal-btn:hover {
			border-color: var(--sl-color-accent);
			color: var(--sl-color-gray-1);
		}

		.search-container {
			min-height: 12rem;
			min-width: 0;
			padding-inline: 0.25rem;
		}

		#starlight__search {
			--pagefind-ui-primary: var(--sl-color-text);
			--pagefind-ui-text: var(--sl-color-gray-2);
			--pagefind-ui-font: var(--__sl-font);
			--pagefind-ui-background: var(--docs-panel-bg, var(--sl-color-black));
			--pagefind-ui-border: var(--docs-panel-border, var(--sl-color-gray-5));
			--pagefind-ui-border-width: 1px;
			--pagefind-ui-tag: var(--sl-color-gray-5);
			--sl-search-cancel-space: 5rem;
		}

		:root[data-theme='light'] #starlight__search {
			--pagefind-ui-tag: var(--sl-color-gray-6);
		}

		@media (min-width: 50rem) {
			dialog {
				margin: 5rem auto auto;
				border-radius: 0.75rem;
				width: 92%;
				max-width: 52rem;
				height: max-content;
				min-height: 18rem;
				max-height: calc(100% - 7rem);
			}

			.dialog-frame {
				padding: 1.5rem 1.5rem 1.75rem;
			}

			.search-container {
				padding-inline: 0.5rem;
			}
		}
	}
</style>

<style is:global>
	@import url('@pagefind/default-ui/css/ui.css') layer(starlight.core);

	@layer starlight.core {
		[data-search-modal-open] {
			overflow: hidden;
		}

		#starlight__search {
			--sl-search-result-spacing: calc(1rem * var(--pagefind-ui-scale));
			--sl-search-result-pad-inline-start: calc(3.2rem * var(--pagefind-ui-scale));
			--sl-search-result-pad-inline-end: calc(1rem * var(--pagefind-ui-scale));
			--sl-search-result-pad-block: calc(0.8rem * var(--pagefind-ui-scale));
			--sl-search-result-nested-pad-block: calc(0.58rem * var(--pagefind-ui-scale));
			--sl-search-corners: calc(0.5rem * var(--pagefind-ui-scale));
			--sl-search-page-icon-size: calc(1.5rem * var(--pagefind-ui-scale));
			--sl-search-page-icon-inline-start: calc(
				(var(--sl-search-result-pad-inline-start) - var(--sl-search-page-icon-size)) / 2
			);
			--sl-search-tree-diagram-size: calc(2.2rem * var(--pagefind-ui-scale));
			--sl-search-tree-diagram-inline-start: calc(
				(var(--sl-search-result-pad-inline-start) - var(--sl-search-tree-diagram-size)) / 2
			);
		}

		#starlight__search .pagefind-ui__search-input {
			color: var(--sl-color-gray-1);
			font-weight: 500;
			width: calc(100% - var(--sl-search-cancel-space));
			border-radius: 0.55rem;
			padding-inline-start: 2.75rem !important;
			box-sizing: border-box;
		}

		#starlight__search .pagefind-ui__search-input::placeholder {
			color: var(--sl-color-gray-4);
		}

		#starlight__search input:focus {
			--pagefind-ui-border: var(--sl-color-accent);
			box-shadow: 0 0 0 3px var(--docs-focus-ring, rgba(94, 106, 210, 0.22));
		}

		#starlight__search .pagefind-ui__search-clear {
			inset-inline-end: 0.5rem;
			min-width: 4rem;
			width: auto;
			padding: 0.35rem 0.6rem;
			background-color: transparent;
			overflow: visible;
			font-size: calc(0.8rem * var(--pagefind-ui-scale));
			border-radius: 0.4rem;
		}

		#starlight__search .pagefind-ui__search-clear:hover {
			background-color: var(--sl-color-gray-6);
		}

		:root[data-theme='light'] #starlight__search .pagefind-ui__search-clear:hover {
			background-color: var(--sl-color-gray-6);
		}

		#starlight__search .pagefind-ui__result {
			border: 0;
			padding: 0;
			margin-bottom: 0.5rem;
		}

		#starlight__search .pagefind-ui__result:last-child {
			margin-bottom: 0;
		}

		#starlight__search .pagefind-ui__result-title:not(:where(.pagefind-ui__result-nested *)),
		#starlight__search .pagefind-ui__result-nested {
			position: relative;
			background: var(--docs-panel-bg, var(--sl-color-black));
			border: 1px solid var(--docs-panel-border, var(--sl-color-gray-5));
			border-radius: 0.5rem;
			padding: 0.75rem 1rem !important;
			margin-bottom: 0.5rem;
		}

		#starlight__search .pagefind-ui__result-nested {
			margin-inline-start: 0.5rem;
			margin-top: 0.35rem;
		}

		#starlight__search .pagefind-ui__result-title:not(:where(.pagefind-ui__result-nested *)):hover,
		#starlight__search .pagefind-ui__result-title:not(:where(.pagefind-ui__result-nested *)):focus-within,
		#starlight__search .pagefind-ui__result-nested:hover,
		#starlight__search .pagefind-ui__result-nested:focus-within {
			border-color: var(--sl-color-accent);
			outline: none;
		}

		#starlight__search .pagefind-ui__result-link {
			position: unset;
			--pagefind-ui-text: var(--sl-color-gray-1);
			font-weight: 600;
		}

		#starlight__search .pagefind-ui__result-excerpt {
			font-size: calc(0.9rem * var(--pagefind-ui-scale));
			overflow-wrap: break-word;
			word-break: break-word;
			color: var(--sl-color-gray-3);
			line-height: 1.5;
			margin-top: 0.25rem;
		}

		#starlight__search .pagefind-ui__result-link {
			display: inline-block;
			line-height: 1.4;
		}

		#starlight__search .pagefind-ui__results {
			display: flex;
			flex-direction: column;
			gap: 0.5rem;
		}

		#starlight__search .pagefind-ui__results-area {
			padding-inline: 0.25rem;
		}

		#starlight__search .pagefind-ui__message {
			padding: 0.5rem 0;
			line-height: 1.4;
		}

		#starlight__search mark {
			color: var(--sl-color-gray-1);
			background: color-mix(in oklab, var(--sl-color-accent) 25%, transparent);
			font-weight: 600;
			padding: 0.12rem 0.28rem;
			border-radius: 0.25rem;
		}
	}
</style>
