---
import Hero from '@/components/landing/Hero';
import Stats from '@/components/landing/Stats';
import Features from '@/components/landing/Features';
import Comparison from '@/components/landing/Comparison';
import ManifestoSection from '@/components/landing/ManifestoSection';
import CTA from '@/components/landing/CTA';
import Footer from '@/components/landing/Footer';
import AppLogo from '@/components/AppLogo';
import { Button } from '@/components/ui/button';
---

<!DOCTYPE html>
<html lang="pt-BR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Saturno OSS | Plataforma open-source para equipes de engenharia" />
		<title>Saturno OSS | Plataforma open-source para equipes de engenharia</title>
	</head>
	<body>
		<div class="min-h-screen bg-[#080B12] font-sans text-slate-200 selection:bg-[#5E6AD2]/35">
			<!-- Background Effects -->
			<div class="pointer-events-none fixed inset-0 z-0">
				<div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
				<div class="absolute inset-0 bg-[radial-gradient(circle_800px_at_50%_200px,#0B0D13_0%,transparent_100%)]" />
				<div class="absolute top-0 left-1/4 h-96 w-96 rounded-full bg-[#5E6AD2]/14 opacity-45 blur-[128px]" />
				<div class="absolute right-1/4 bottom-0 h-96 w-96 rounded-full bg-[#5FA8FF]/12 opacity-40 blur-[128px]" />
			</div>

			<div class="relative z-10 flex min-h-screen flex-col">
				<!-- Navbar -->
				<nav class="sticky top-0 z-50 border-b border-white/5 bg-[#080B12]/60 backdrop-blur-xl">
					<div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">
						<div class="flex items-center gap-2">
							<a href="/" class="flex items-center gap-2">
								<AppLogo client:load />
							</a>
						</div>
						<div class="hidden items-center gap-6 text-sm text-slate-400 md:flex">
							<a href="#features" class="transition-colors hover:text-white">
								Recursos
							</a>
							<a href="#comparison" class="transition-colors hover:text-white">
								Comparacao
							</a>
							<a href="#manifesto" class="transition-colors hover:text-white">
								Manifesto
							</a>
							<a href="#cta" class="transition-colors hover:text-white">
								Comecar
							</a>
						</div>
						<div class="flex items-center gap-4">
							<a href="/docs/">
								<Button
									size="sm"
									className="border-0 bg-white/10 text-white backdrop-blur-md hover:bg-white/20"
								>
									Documentação
								</Button>
							</a>
							<a href="https://github.com/gabrielalmir/saturno" target="_blank" rel="noopener noreferrer">
								<Button
									size="sm"
									className="border-0 bg-[#5E6AD2] text-white shadow-[0_0_20px_rgba(94,106,210,0.35)] hover:bg-[#6A77DF]"
								>
									Começar agora
								</Button>
							</a>
						</div>
					</div>
				</nav>

				<main class="flex-grow">
					<Hero client:load />
					<Stats client:visible />
					<Features client:load />
					<Comparison client:load />
					<ManifestoSection client:load />
					<CTA client:load />
				</main>

				<Footer client:load />
			</div>
		</div>
	</body>
</html>
